{
  "name": "@sdlc-on-fire/db",
  "version": "0.0.0",
  "description": "PostgresAdapter for the StoragePort: Drizzle schema, migrations, pgvector provisioning, HNSW DDL.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/sdlc-on-fire.git",
    "directory": "packages/db"
  },
  "homepage": "https://github.com/faraasat/sdlc-on-fire#readme",
  "bugs": "https://github.com/faraasat/sdlc-on-fire/issues",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && tsup",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-pgvector": "0.0.5",
    "@sdlc-on-fire/core": "workspace:*",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4"
  }
}
