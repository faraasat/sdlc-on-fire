{
  "name": "@sdlc-on-fire/storage",
  "version": "0.1.0-alpha.1",
  "description": "Markdown typed reader/writer, chokidar watcher, sha256 hash-guard sync pipeline, AST chunker.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/sdlc-on-fire.git",
    "directory": "packages/storage"
  },
  "homepage": "https://github.com/faraasat/sdlc-on-fire#readme",
  "bugs": "https://github.com/faraasat/sdlc-on-fire/issues",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && tsup",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sdlc-on-fire/core": "workspace:*",
    "yaml": "2.9.0"
  }
}
