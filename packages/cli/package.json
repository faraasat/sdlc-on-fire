{
  "name": "sdlc-on-fire",
  "version": "0.0.0",
  "description": "The sdlc CLI: Commander entrypoint with a --json twin on every command. The published surface of SDLC on Fire.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/sdlc-on-fire.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/faraasat/sdlc-on-fire#readme",
  "bugs": "https://github.com/faraasat/sdlc-on-fire/issues",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sdlc": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && tsup",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sdlc-on-fire/agent-manager": "workspace:*",
    "@sdlc-on-fire/core": "workspace:*",
    "@sdlc-on-fire/daemon": "workspace:*",
    "@sdlc-on-fire/db": "workspace:*",
    "@sdlc-on-fire/storage": "workspace:*",
    "commander": "15.0.0",
    "yaml": "2.9.0"
  }
}
