{
  "name": "@sdlc-on-fire/importers",
  "version": "0.1.0-alpha.1",
  "description": "Importer framework: tool parser port, tool-independent IR, and the transactional dependency-ordered writer with external_ref idempotency.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/sdlc-on-fire.git",
    "directory": "packages/importers"
  },
  "homepage": "https://github.com/faraasat/sdlc-on-fire#readme",
  "bugs": "https://github.com/faraasat/sdlc-on-fire/issues",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && tsup",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sdlc-on-fire/storage": "workspace:^",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {},
  "peerDependencies": {
    "@sdlc-on-fire/core": "workspace:^"
  }
}
