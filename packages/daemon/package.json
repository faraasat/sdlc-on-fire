{
  "name": "@sdlc-on-fire/daemon",
  "version": "0.1.0-alpha.1",
  "description": "Long-running local process: watcher wiring, git integration, gates, WebSocket fan-out, single-instance lock.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/sdlc-on-fire.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://github.com/faraasat/sdlc-on-fire#readme",
  "bugs": "https://github.com/faraasat/sdlc-on-fire/issues",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && tsup",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sdlc-on-fire/context": "workspace:^",
    "@sdlc-on-fire/db": "workspace:^",
    "@sdlc-on-fire/evidence": "workspace:^",
    "@sdlc-on-fire/storage": "workspace:^",
    "chokidar": "5.0.0",
    "simple-git": "3.36.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "peerDependencies": {
    "@sdlc-on-fire/core": "workspace:^"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
