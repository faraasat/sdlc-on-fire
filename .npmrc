# Workspace packages resolve to the local source, never the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Reproducible installs: fail rather than silently rewriting the lockfile in CI.
# (Locally `pnpm install` still updates it; CI sets --frozen-lockfile explicitly.)
save-exact=true

# Supply-chain hygiene — no package runs install scripts unless explicitly allowed
# in pnpm.onlyBuiltDependencies (ADR-0033).
enable-pre-post-scripts=false
